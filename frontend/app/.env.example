# Frontend (Vite) environment variables — copy to `.env` and fill in.
# NOTE: `.env` is gitignored, so you can put a real number here safely.

# Phone number the "Borderline — phone verify" scenario will ask Twilio to call.
# Must be in E.164 format (e.g. +91XXXXXXXXXX). Leave blank to use the demo
# placeholder in src/api.js. Change this to test different numbers.
VITE_DEMO_PHONE=+919876543210
