# Copy this file to .env and fill in your own values. NEVER commit .env.
#
# ==== Security / authentication ====
# Token-signing secret. In production use a long random value from your secret
# manager (e.g. `openssl rand -hex 32`). With SENTINEL_STRICT=1 the app refuses
# to start if this is left at the demo default.
SENTINEL_AUTH_SECRET=
SENTINEL_ADMIN_PASSWORD=
# For production, set SENTINEL_STRICT=1 to forbid the insecure demo defaults.
SENTINEL_STRICT=0
# Token lifetime in seconds (default 12h = 43200).
SENTINEL_TOKEN_TTL=43200

# ==== CORS ====
# Comma-separated allowed origins. Default "*" is for the local demo only.
# For production, e.g. SENTINEL_CORS_ORIGINS=https://dashboard.yourcompany.com
SENTINEL_CORS_ORIGINS=*

# ==== OTP ====
# Force redaction of the OTP in API responses (production). Set to 1 so the raw
# OTP is never returned to the client; it is only delivered to the payer phone.
SENTINEL_REDACT_OTP=0

# Razorpay keys (rzp_test_*)
# Copy this file to .env and fill in your own Razorpay TEST-mode keys.
# NEVER commit this file. NEVER use live keys in a demo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OPTIONAL Twilio keys for REAL phone-call payment confirmation.
# Only used if the `twilio` package is installed AND all three are set.
# Without them, the phone-verification flow runs in SIMULATED mode (OTP + call
# script shown in the dashboard) so the buildathon demo works fully offline.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
