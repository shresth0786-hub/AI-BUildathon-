# Backend — never commit secrets or model artifacts (regenerate with `python train.py`)
.env
__pycache__/
*.pyc
.venv/
venv/
backend/artifacts/*
!backend/artifacts/.gitkeep
backend/data/*
backend/database/*
!backend/database/.gitkeep
backend/app/database/db/*

# Frontend
frontend/app/node_modules/
frontend/app/dist/
frontend/app/.env
